---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site">
  <div class="wrap">
    <span>© {year} {site.nombre}</span>
    <span class="links">
      <a href={`mailto:${site.email}`}>Correo</a>
      <a href={site.linkedin} rel="me noopener">LinkedIn</a>
      <a href={site.github} rel="me noopener">GitHub</a>
    </span>
  </div>
</footer>

<style>
  footer.site {
    border-top: 1.5px solid var(--fg);
  }
  .wrap {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-block: 22px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  .links {
    display: flex;
    gap: 18px;
  }
  a {
    text-underline-offset: 3px;
  }
  a:hover {
    color: var(--fg);
  }
</style>
