---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  proyectos: CollectionEntry<'proyectos'>[];
}
// Proyectos sin IA dentro del producto: lista compacta. El homelab tiene su propia sección justo debajo.
const proyectos = Astro.props.proyectos.filter((p) => !p.data.destacado && p.id !== 'homelab');
---

<section class="others" id="otros">
  <div class="wrap">
    <div class="head">
      <p class="kicker">Otros proyectos</p>
      <h2 class="display">Más cosas que he publicado</h2>
      <p class="lead">
        Aquí la IA no va dentro del producto, pero el método es el mismo: los programaron agentes dirigidos por mí y los he llevado hasta
        publicarlos.
      </p>
    </div>
    <ul>
      {
        proyectos.map((p) => (
          <li style={`--c:${p.data.color};--t:${p.data.tinta}`}>
            <a href={`/proyectos/${p.id}/`}>
              <span class="thumb" aria-hidden="true">
                {p.data.captura ? <Image src={p.data.captura} alt="" width={160} /> : <span class="rack-mini" />}
              </span>
              <span class="body">
                <span class="status" data-estado={p.data.estado}>
                  <i />
                  {p.data.estadoTexto}
                </span>
                <span class="name">{p.data.titulo}</span>
                <span class="what">{p.data.entradilla}</span>
                <span class="stack mono">{p.data.stack.slice(0, 4).join(' · ')}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .others {
    padding-block: clamp(72px, 10vw, 120px);
    border-top: 1.5px solid var(--fg);
  }
  .head {
    display: grid;
    gap: 16px;
    max-width: 900px;
    margin-bottom: clamp(32px, 5vw, 48px);
  }
  h2 {
    font-size: clamp(40px, 6vw, 80px);
  }
  .lead {
    color: var(--muted);
    font-size: clamp(17px, 1.7vw, 19px);
    max-width: 56ch;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  @media (min-width: 760px) {
    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  a {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
    height: 100%;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 20px;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }
  a:hover,
  a:focus-visible {
    border-color: var(--fg);
    transform: translateY(-2px);
  }
  .thumb {
    display: flex;
    justify-content: center;
    height: 112px;
    padding-top: 12px;
    border-radius: 12px;
    background: var(--c);
    overflow: hidden;
  }
  .thumb :global(img) {
    width: 62px;
    height: auto;
    align-self: flex-start;
    border: 3px solid #050506;
    border-bottom: 0;
    border-radius: 12px 12px 0 0;
  }
  /* Miniatura del homelab: tres unidades de rack */
  .rack-mini {
    width: 60px;
    margin-top: 14px;
    height: 64px;
    background: repeating-linear-gradient(180deg, #2a2d33 0 16px, transparent 16px 22px);
    border-radius: 3px;
    position: relative;
  }
  .rack-mini::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 6px;
    width: 4px;
    height: 48px;
    background: repeating-linear-gradient(180deg, var(--led) 0 4px, transparent 4px 22px);
  }
  .body {
    display: grid;
    gap: 6px;
    min-width: 0;
  }
  .status {
    color: var(--muted);
    font-size: 11px;
  }
  .name {
    font-weight: 800;
    font-stretch: 68%;
    font-size: clamp(28px, 2.8vw, 36px);
    line-height: 0.95;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .what {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.45;
  }
  .stack {
    color: var(--muted);
    font-size: 11.5px;
  }
</style>
